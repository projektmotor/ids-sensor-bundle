# Nicht mit dem Paket ausliefern. Was hier fehlt, landet im Dist-Archiv und damit
# bei jedem Konsumenten — geprüft wird das mit `git archive HEAD | tar -t`.
#
# src/, config/, README.md, CHANGELOG.md und LICENSE bleiben drin: das erste Paar
# ist das Paket, das zweite erklärt es. CLAUDE.md dagegen richtet sich an die
# Entwicklung dieses Bundles und hat beim Konsumenten nichts zu suchen.
/tests               export-ignore
/docker              export-ignore
/doc                 export-ignore
/.github             export-ignore
/docker-compose.yml  export-ignore
/phpunit.xml.dist    export-ignore
/phpstan.neon.dist   export-ignore
/.php-cs-fixer.dist.php export-ignore
/Makefile            export-ignore
/CLAUDE.md           export-ignore
/.gitattributes      export-ignore
/.gitignore          export-ignore
